# ==============================================================================
# AKSA MEET - ENVIRONMENT VARIABLES CONFIGURATION (.env.local)
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# Then fill in your own keys from Stream and Clerk dashboards.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STREAM VIDEO & CHAT (https://getstream.io)
# ------------------------------------------------------------------------------
# 1. Sign up / log in to https://getstream.io
# 2. Open your dashboard and select (or create) an app with 'Video & Chat' enabled
# 3. Find your Key and Secret under 'App Keys' on the app overview page
#
# NEXT_PUBLIC_STREAM_API_KEY is used by the frontend to initialize video/chat clients.
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key_here

# STREAM_API_SECRET is kept on the server to sign user tokens (/api/token).
STREAM_API_SECRET=your_stream_api_secret_here


# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (https://clerk.com)
# ------------------------------------------------------------------------------
# 1. Sign up / log in to https://clerk.com
# 2. Create an application (enable Email, Google, etc. under Authentication)
# 3. Copy Publishable Key and Secret Key from: Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# CLERK WEBHOOK SECRET (Optional for local testing, recommended for production)
# 1. In Clerk Dashboard -> Configure -> Webhooks -> Add Endpoint
# 2. Set Endpoint URL to: https://<your-domain>/api/webhooks
# 3. Subscribe to events: 'user.created' and 'user.updated'
# 4. Copy the Signing Secret (starts with whsec_...) and paste below:
WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# CLERK ROUTE REDIRECTS (Standard Next.js App Router paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
