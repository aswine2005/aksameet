# ==============================================================================
# AKSA MEET - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in your own keys:
#   cp .env.example .env.local
# Never commit .env.local — it is ignored by git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STREAM VIDEO & CHAT (https://getstream.io) — required
# ------------------------------------------------------------------------------
# Dashboard -> your app -> "App Access Keys". Video and Chat share one app.
#
# Public key, used by the browser to connect the video and chat clients.
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key_here

# Secret, used only on the server to sign user tokens. Keep it private.
STREAM_API_SECRET=your_stream_api_secret_here


# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (https://clerk.com) — required
# ------------------------------------------------------------------------------
# Dashboard -> API Keys. Use pk_live_/sk_live_ keys for production deployments.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Enable Google in Clerk Dashboard -> User & Authentication -> Social connections.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/


# ------------------------------------------------------------------------------
# 3. MONGODB — meeting history, attendance and attention (required)
# ------------------------------------------------------------------------------
# Production (Vercel): a MongoDB Atlas connection string. In Atlas, allow
# network access from anywhere (0.0.0.0/0) -- Vercel's IP addresses change.
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=AksaMeet
# Local development: run `npm run db:dev` and use
#   MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGODB_URI=
# Optional; defaults to "aksameet".
MONGODB_DB=aksameet


# ------------------------------------------------------------------------------
# 4. AKSARANK (optional)
# ------------------------------------------------------------------------------
# The live AksaRank URL. When set, AksaMeet links back to it from the header
# and the home page.
NEXT_PUBLIC_AKSARANK_URL=


# ------------------------------------------------------------------------------
# 5. CLERK WEBHOOK (optional)
# ------------------------------------------------------------------------------
# Keeps Stream user profiles in sync when users edit their Clerk profile.
# Users are also synced automatically whenever they connect, so this is optional.
#   Clerk Dashboard -> Webhooks -> Add Endpoint
#   URL:    https://<your-domain>/api/webhooks
#   Events: user.created, user.updated
WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
